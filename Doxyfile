# PROJECT DETAILS
PROJECT_NAME           = "Multithreading"
PROJECT_NUMBER         = $(KERNEL_TAG)
PROJECT_BRIEF          = "Kernel source code documentation via Doxygen and Graphviz"
OUTPUT_DIRECTORY       = .
HTML_OUTPUT            = html


# ARCHITECTURE DIAGRAM ON MAIN PAGE
USE_MDFILE_AS_MAINPAGE = MAINPAGE.md
IMAGE_PATH += ./images


# INPUT FILES/ INCLUDE & EXCLUDE FILE PATHS
@INCLUDE = input_files.txt
@INCLUDE = include_path.txt
@EXCLUDE = exclude_path.txt

INPUT_FILTER           = ./doxygen_kernel_filter.sh
FILTER_SOURCE_FILES    = YES

RECURSIVE              = YES
EXTENSION_MAPPING      = h=C # Ensures .h headers are explicitly treated as C files (Fixes kthread.h / sched.h missing symbols)
FILE_PATTERNS          = *.c *.h # Forces Doxygen to parse all .c and .h files even without explicit @file directives


# DOCUMENTATION & EXTRACTION DETAILS
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES

EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES # Forces extraction of local file functions and prototypes
EXTRACT_PACKAGE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_NAMESPACES  = NO # Ensures unannotated kernel namespaces/subsystems are shown
SHOW_USED_FILES        = YES
SHOW_INCLUDE_FILES     = YES


# KERNEL-DOC / JAVADOC COMMENT FORMATTING & ALIASES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_PV     = YES
MARKDOWN_SUPPORT       = YES

ALIASES               += "param=\param" \
                         "return=\return" \
                         "returns=\return"


# PREPROCESSOR & MACRO EXPANSION
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES # Strictly ON to preserve macro definitions in exit.c and prevent header parsing failures
SEARCH_INCLUDES        = YES
SKIP_FUNCTION_MACROS   = NO # Ensures macro definitions in exit.c and sched.h are extracted as documentation entities

PREDEFINED             = "asmlinkage=" \
                         "__latent_entropy=" \
                         "__randomize_layout=" \
                         "__kfifo_int512=" \
                         "rcu_head=callback_head" \
                         "__counted_by(x)=" \
                         "__counted_by_or_null(x)=" \
                         "__private=" \
                         "__nonstring=" \
                         "__copy_data(x)=" \
                         "__struct_group(x...)=x" \
                         "__cacheline_aligned=" \
                         "__cacheline_aligned_in_smp=" \
                         "____cacheline_aligned=" \
                         "____cacheline_aligned_in_smp=" \
                         "__read_mostly=" \
                         "__ro_after_init=" \
                         "__attribute__(x)=" \
                         "__attribute_const__=" \
                         "__user=" \
                         "__rcu=" \
                         "__aligned(x)=" \
                         "__must_check=" \
                         "__sched=" \
                         "__always_inline=" \
                         "noinline=" \
                         "__printf(a,b)=" \
                         "__noreturn=" \
                         "__ref=" \
                         "__init=" \
                         "__meminit=" \
                         "__maybe_unused=" \
                         "__always_unused=" \
                         "SYSCALL_DEFINE0(name)=long sys_##name(void)" \
                         "SYSCALL_DEFINE1(name, ...)=long sys_##name(...)" \
                         "SYSCALL_DEFINE2(name, ...)=long sys_##name(...)" \
                         "SYSCALL_DEFINE3(name, ...)=long sys_##name(...)" \
                         "SYSCALL_DEFINE4(name, ...)=long sys_##name(...)" \
                         "SYSCALL_DEFINE5(name, ...)=long sys_##name(...)" \
                         "SYSCALL_DEFINE6(name, ...)=long sys_##name(...)" \
                         "COMPAT_SYSCALL_DEFINE1(name, ...)=long sys_##name(...)" \
                         "COMPAT_SYSCALL_DEFINE2(name, ...)=long sys_##name(...)" \
                         "COMPAT_SYSCALL_DEFINE3(name, ...)=long sys_##name(...)" \
                         "COMPAT_SYSCALL_DEFINE4(name, ...)=long sys_##name(...)" \
                         "COMPAT_SYSCALL_DEFINE5(name, ...)=long sys_##name(...)" \
                         "COMPAT_SYSCALL_DEFINE6(name, ...)=long sys_##name(...)" \
                         "__struct_group(TAG, NAME, ATTRS, MEMBERS...)=MEMBERS" \
                         "struct_group(NAME, MEMBERS...)=MEMBERS" \
                         "struct_group_attr(NAME, ATTRS, MEMBERS...)=MEMBERS" \
                         "struct_group_tagged(TAG, NAME, MEMBERS...)=MEMBERS" \
                         "EXPORT_SYMBOL(x)=" \
                         "EXPORT_SYMBOL_GPL(x)=" \
                         "DECLARE_BITMAP(x,y)=unsigned long x[y]" \
                         "NETDATA_ALIGN=" \
                         "__ASSEMBLY__=0" \
                         "CONFIG_THREAD_INFO_IN_TASK=1" \
                         "CONFIG_NUMA=1" \
                         "CONFIG_SCHED_AUTOGROUP=1" \
                         "CONFIG_SMP=1" \
                         "CONFIG_PREEMPT_RT=1" \
                         "CONFIG_SCHED_CORE=1" \
                         "TASK_PFA_TEST(name, func)=bool task_##func(struct task_struct *p);" \
                         "TASK_PFA_SET(name, func)=void task_set_##func(struct task_struct *p);" \
                         "TASK_PFA_CLEAR(name, func)=void task_clear_##func(struct task_struct *p);" \
                         "DECLARE_BITMAP(name,bits)=unsigned long name[bits];"


# GRAPHING AND GRAPHVIZ DETAILS
HAVE_DOT               = YES
DOT_GRAPH_MAX_NODES    = 1000 # Large positive integer allows complete header trees without disabling DOT
MAX_DOT_GRAPH_DEPTH    = 10   # Allows Graphviz to traverse deep header dependency trees
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = NO
DOT_MULTI_TARGETS      = YES
DOT_NUM_THREADS        = 4

CLASS_DIAGRAMS         = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GENERATE_LEGEND        = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

SHOW_DIRECTORIES       = YES
DIRECTORY_GRAPH        = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
FORCE_LOCAL_INCLUDES   = NO # Ensures both quotes and angle-bracket includes (<linux/sched.h>) render in graph trees


# OUTPUT GENERATOR FORMATS
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

HTML_DYNAMIC_SECTIONS  = NO
HTML_CODE_FOLDING      = YES
TOC_INCLUDE_HEADINGS   = 3


# LEFT SIDEBAR AND TREEVIEW SETUP
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
DISABLE_INDEX          = NO
FULL_SIDEBAR           = YES
SHOW_NAMESPACES        = YES
SHOW_FILES             = YES
SHOW_ENUMS             = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
HTML_INDEX_NUM_ENTRIES = 100
